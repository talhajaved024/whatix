{
    servers {
        # Nginx reaches the loopback-published web port via the VPS Docker gateway.
        trusted_proxies static 172.18.0.1/32
        # Use the address Nginx saw, never a client-supplied X-Forwarded-For
        # entry (login rate limits and the recorded login IP depend on it).
        trusted_proxies_strict
    }
}

http://:80 {
    # Security headers for every response (the page also ships its own
    # Content-Security-Policy meta tag; frame-ancestors only works as a header).
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(), geolocation=(), payment=(), usb=(), microphone=(self)"
        -Server
    }
    handle /api/* {
        # Media sends carry base64 attachments (WAHA's limit is 50 MiB).
        request_body {
            max_size 60MB
        }
        reverse_proxy api:8080 {
            header_up X-Forwarded-For {client_ip}
            flush_interval -1
        }
    }
    # Built files carry a content hash in their name, so one that exists never
    # changes: browsers may keep it for good.
    @asset {
        path /assets/*
        file {
            root /srv
        }
    }
    handle @asset {
        header Cache-Control "public, max-age=31536000, immutable"
        root * /srv
        file_server
    }
    # A built file that is not here (a browser still on the previous release, or
    # a rollback) is a 404, never the page below: browsers cached that page under
    # the script's address and the screen then failed to open until the cache expired.
    handle /assets/* {
        header Cache-Control "no-store"
        respond 404
    }
    handle {
        header Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'none'"
        header X-Frame-Options SAMEORIGIN
        # The page names the current build's files: browsers must ask for it each
        # time (a cheap 304), or they keep running the previous release for hours.
        header Cache-Control "no-cache"
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
