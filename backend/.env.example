NODE_ENV=development
PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
WAHA_URL=http://127.0.0.1:3000
WAHA_SESSION=TEST_BULK
WAHA_API_KEY=replace-with-your-private-waha-key
ADMIN_USERNAME=super_user
ADMIN_PASSWORD=admin
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-of-at-least-32-characters
# TRUST_PROXY=1
# ALLOW_INSECURE_DEMO_CREDENTIALS=true
# Writable Excel workbook for regular user accounts
USER_WORKBOOK_PATH=data/users.xlsx

# Set the model to enable offline acknowledgments. Use AWAY_REPLIES_ENABLED=false to pause.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

AWAY_REPLIES_ENABLED=false
BUSY_REPLIES_ENABLED=false

# Optional SQLite settings. Keep the effective password secret stable after first startup.
# WHATIX_DB_PATH=data/whatix.db
# WHATIX_PASSWORD_SECRET=<independent random secret set before database creation>

# Used by the admin-only embedded WAHA dashboard. When omitted, WAHA prompts
# for its dashboard credentials in the browser.
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=
